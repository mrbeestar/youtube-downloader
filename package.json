{
  "name": "telegram-downloader-bot",
  "version": "1.0.0",
  "description": "بوت تيليجرام لتحميل الفيديوهات من يوتيوب، تيك توك، فيسبوك، إنستجرام، سناب شات",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "bash scripts/install-yt-dlp.sh && node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.44.2",
    "pg": "^8.16.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "telegraf": "^4.16.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.0",
    "drizzle-zod": "^0.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
